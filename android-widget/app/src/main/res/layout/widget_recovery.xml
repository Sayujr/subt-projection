<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:singleLine="true"
            android:text="RECOVERY"
            android:textColor="@color/text"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_faint"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Refresh"
            android:padding="4dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>
    <TextView
        android:id="@+id/rec_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:maxLines="3" />
    <LinearLayout
        android:id="@+id/rec_tiles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/tile_bg"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="7dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:text="HRV"
            android:textColor="#FF2DD4BF"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/hrv_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="–"
            android:textColor="@color/text"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/hrv_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/hrv_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:contentDescription="HRV trend"
            android:scaleType="fitXY" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/tile_bg"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="7dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:text="RESTING HR"
            android:textColor="#FFFF7A90"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/rhr_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="–"
            android:textColor="@color/text"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/rhr_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/rhr_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:contentDescription="RESTING HR trend"
            android:scaleType="fitXY" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/tile_bg"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="7dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:text="SLEEP"
            android:textColor="#FF8C9EFF"
            android:textSize="9sp" />
        <TextView
            android:id="@+id/sleep_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="–"
            android:textColor="@color/text"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/sleep_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/sleep_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:contentDescription="SLEEP trend"
            android:scaleType="fitXY" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
